import fib::Type;
import api::Runner;
import api::Data;

class is Runner {
    uint64 CountTo;

    Fibonacci (Data data) {
        self.CountTo = data.GetCountTo();
    }

    override func Run (Type type) {
        switch (type) {
            case Type.ITERATIVE: {
                iterative();
                break;
            }
            case Type.RECURSIVE: {
                var result = recursive(CountTo);
                println("Recursive Fibonacci result: ");
                println(result);
                break;
            }
        }
    }

    func iterative () {
        print("Iterative Fibonacci up to ");
        print(CountTo);
        println();

        uint64 firstTerm = 0;
        uint64 secondTerm = 1;

        for (uint64 i = 0; i < CountTo; i++) {
            println(firstTerm);
            uint64 nextTerm = firstTerm + secondTerm;
            firstTerm = secondTerm;
            secondTerm = nextTerm;
        }

        println("Iterative Fibonacci complete.");
    }

    func recursive (uint64 n): uint64 {
        if (n <= 1) {
            return n;
        }
        return recursive(n - 1) + recursive(n - 2);
    }
}