import fib::Fibonacci;
import fib::Type;
import api::Data;
import api::BelowZeroError;
import cloth.math::Math;

// Main entry method
static func Main (string[] args) throws BelowZeroError {
    printArgs(args);

    // Random number to count to. Its low as I am impatient. 
    // Could make this a uint32 on default, but im testing 
    // explicit endedness for u32. 
    // TODO: When an input default func is available, use it to set countTo.
    var countTo = 0xFu32; // 15

    if (countTo <= 0) {
        throw BelowZeroError("Count must be greater than zero."); 
    }

    // Create a Data instance with the specified countTo value.
    Data data = Data(uint64(countTo));

    // Create a Fibonacci instance with the specified countTo value.
    // This also tests converting a uint (32-bit) to a uint64 (64-bit) via "casting".
    var fib = Make(data);
    
    // Passes a test enum value to the Run method.
    fib.Run(Type.RECURSIVE);

    println();

    fib.Run(Type.ITERATIVE);

    println();

    println(Math.PI);
}

static func printArgs (string[] args) {
    for (var arg in args) {
        println(arg);
    }
}

// Constructs a Fibonacci instance with the specified countTo value.
static func Make(Data data): Fibonacci {
    return Fibonacci(data);
}